# Congress.gov API -- register at https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# Census Bureau API -- register at https://api.census.gov/data/key_signup.html (instant, free)
# Used only by scripts/generate-districts.ts (not at runtime)
CENSUS_API_KEY=

# Guardian Open Platform -- register at https://open-platform.theguardian.com/access/ (instant, free, 500 calls/day)
GUARDIAN_API_KEY=

# FEC API -- no key required (DEMO_KEY is used automatically if absent, rate-limited)
# FEC_API_KEY=
